  "authority": {
    "confirmed": [
      "Primordial is an initial entity not created by another god; deliberate self-creation not required.",
      "Primordial race receives a six-point package.",
      "Primordial Champion receives a three-point package.",
      "Assign power, weapon and/or stat bonuses based on lore.",
