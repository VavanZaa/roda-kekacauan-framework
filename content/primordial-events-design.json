  "definitionContract": {
    "status": "user-confirmed-definition",
    "userClarification": "as long as they are not created by other god and the first. they count as primordial",
    "conditions": [
      "At the origin of the selected cosmogony",
      "Not created, engendered or born from another deity in that selected account"
    ],
    "selfCreationRequired": false,
    "firstInterpretation": "Design interpretation: a first entity, co-first pair, or initial independently emerging generation before derivative divine genealogies; not every later creator or merely old god. The earliest cosmic medium may pre-exist without acting as a deity-parent.",
    "allowedOrigins": [
      "self-origin",
      "spontaneous emergence",
      "primordial waters",
      "interaction of primordial elements"
    ],
    "indirectCreationRule": "A deity that deliberately fashions the egg or vessel of another entity counts as a creator; intermediate egg birth does not bypass the rule.",
    "versionRule": "Evaluate one stated source version; do not combine incompatible genealogies into one eligibility claim.",
    "uncertaintyRule": "An unknown origin remains review-needed until a source-qualified design assessment exists; absence of a named parent is not a claim that every tradition denies parents.",
    "logicalPredicate": "originPosition in {first, co-first, initial-independent-generation} AND noOtherDeityCreatorAssessment=pass; false excludes, unknown requires review. Runtime registration remains disabled.",
    "mechanicsScope": "This is a curation contract for a draft identity list; it dispatches no event or reward."
  },
