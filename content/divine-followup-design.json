{
  "schemaVersion": "roda-kekacauan-divine-followups/1.0",
  "version": "divine-followups/1.0.0",
  "updatedDate": "2026-10-11",
  "scope": "All12 existing Divine recipes only",
  "authority": "User delegates follow-up event mechanisms for the preceding12 Divine effects.",
  "designReady": true,
  "runtimeReady": false,
  "status": "Structured algorithm and editable narration; persistent/video/combat adapters are not implemented.",
  "mainStatKeys": [
    "strength",
    "speed",
    "durability",
    "intelligence",
    "fight"
  ],
  "sharedLifecycle": [
    "Read completed actor snapshot and classify child recipe eligibility before the effect draw.",
    "Keep the confirmed seven-root weights; normalize only the selected branch eligible effect leaves.",
    "Persist the actual effect result and react using completed facts.",
    "Run recipe steps sequentially, freeze only the next required live pool after its dependencies commit.",
    "Persist each selection and effect under a stable source key; react before the next spin.",
    "Complete all required children and any first-late-power mastery gate, then return to saved Title continuation.",
    "After Title/mandatory late events, settle mastery for the ordinary Enchant gate and complete Enchant children; final card includes all accumulated source-once modifiers/hooks."
  ],
  "planningInterface": {
    "name": "planDivineFollowup",
    "implemented": false,
    "inputs": [
      "runId",
      "characterId",
      "eventInvocationId",
      "recipeId",
      "committedActorSnapshot",
      "mainStatResolutionProofs",
      "activeInventory",
      "sharedMasteryProof",
      "weaknessStates",
      "modifierLedger",
      "savedContinuation"
    ],
    "returns": [
      "ready-next-step",
      "fixed-reveal-no-RNG",
      "await-actual-child",
      "complete-return-to-title",
      "needs_configuration"
    ],
    "sourceKey": "[runId,characterId,eventInvocationId,recipeId,stepId]",
    "exactReplay": "Reuse frozen plans/receipts and no new RNG, charge consumption, bonus, Lucky or funny hit.",
    "staleSnapshot": "Revalidate frozen proof/version atomically before commit; do not silently redraw or retarget."
  },
  "targetSelectionContract": {
    "basePolicy": "uniform-among-eligible-targets",
    "defaultWeight": 1,
    "equalizer": "Uniform after hard guards; target wheels are already equal by default.",
    "noTarget": "Remove recipe before effect draw; unknown proof/configuration is needs_configuration, not absence.",
    "oneTarget": "Reveal target directly; no RNG, no actual spin, no sampled numeric/funny hit.",
    "manyTargets": "One segment per distinct target instance/ID and one actual target draw.",
    "numericBoundsApply": false,
    "boundsExplanation": "Stat/mastery5%..25% bounds apply actual raw tier draws only; target/effect wheels are unrestricted.",
    "sourceProof": "Only committed owned targets, never future grants, discarded weapon labels or narrator guesses.",
    "targetResultKind": "selection; no numeric raw result and no inherited funny flag from an already-owned item.",
    "newTargetWheelFunnyResult": false,
    "presentation": "Anticlockwise; target labels use canonical order or live inventory order, not invented strength ranking."
  },
  "effectSelectionContract": {
    "default": "Four candidate recipes per branch, weight1 each before live hard guards.",
    "eligible": "Check owned target/state proofs from this complete snapshot before drawing the effect.",
    "missingTarget": "Remove only that recipe, normalize this child branch; preserve parent root probabilities.",
    "unknownProof": "Return needs_configuration before selection; do not silently remove a potentially eligible recipe.",
    "singleton": "Direct reveal and execute sole eligible recipe; no RNG or sampled spin.",
    "empty": "needs_configuration; never fallback to another root or None.",
    "narration": "One completed effect reveal/reaction even when selected deterministically."
  },
  "chargeUseContract": {
    "registeredAt": "Divine result, not consumed during generation or character image display",
    "applies": "Add1 to the corresponding effective combat stat for exactly one qualifying resolved action.",
    "thinShield": "First actual incoming hit that reaches the durability calculation; misses/cancelled actions do not consume.",
    "reserveBreath": "First actual dodge attempt that reaches the dodge calculation; success or failure consumes.",
    "briefFocus": "First actual outgoing attack that reaches the Fight calculation; success or miss consumes.",
    "consumption": "Atomic action receipt with trait source key and distinct actionId; charges1->0 once.",
    "expiry": "No extra lifespan/stack/refresh wheel; unused trait remains pending.",
    "card": "Separate single-use trait, not an always-on stat increase or owned power."
  },
  "secondChanceContract": {
    "status": "authored-followup-policy; runtime adapter pending",
    "target": "Lowest eligible retained raw before bonuses; uniform ties or direct reveal for one.",
    "original": "Immutable original resolution, multiplier decision, copies and raw history remain unchanged.",
    "conditionalOdds": "Reuse ordinary stat planner with a fresh stable late invocation and current committed lore context; no self-reward bonus input.",
    "ordinaryFormula": "min(2,max(0,newRetainedRaw-oldRetainedRaw))",
    "comparisonFormula": "min(2,max(0,newResolution.baseValue-originalResolution.baseValue))",
    "formulaExplanation": "Ordinary/High Roller/All In sampled base equals retained raw. Double/Nothing uses its separately resolved derived base; this refines the earlier raw-only shorthand for that mode.",
    "resilient": "If this new first attempt<=5, one retry using the same frozen late pool; retain the higher raw, at most two attempts.",
    "doubleOrNothing": "After retaining the new raw, run its separate50:50 Double/Nothing wheel once. Compare new derived base to original derived base, refund0..2; Nothing cannot reduce the original stat.",
    "highRoller": "Keep normal four extreme raw sectors0/1/8/9 and existing bounds; do not invent mid-tier sectors.",
    "allIn": "Only the original actual Strength resolution is eligible; other four copied categories have no independent retained draw. New reward is a Strength-only final modifier, not a new copy across all five.",
    "luckyNumber": "Each genuinely sampled raw attempt, including Resilient retry, can count once under its spinId; target-selection/Double decision/bonus/replay does not count.",
    "pawn": "Send new retained raw observation to the same target category; preserve original evidence and count distinct categories, not each attempt as a new category. Existing evolution reward is source-once.",
    "zero": "Complete with0 bonus when no improvement; no recursive retry or fallback reward.",
    "budget": "Cap only this event direct refund at2; existing actual Lucky/Pawn rewards remain independent final sources."
  },
  "latePowerMasteryContract": {
    "powerAlreadyOwned": "Reuse one existing settled shared mastery; no second mastery spin.",
    "godGuarantee": "Actual qualifying fixed9 shared mastery remains fixed9 without RNG; final modifiers still apply.",
    "firstPower": "If ordinary earlier gate skipped because inventory was empty, request exactly one normal shared mastery resolution immediately after this grant, using normal stat odds/Resilient/Lucky rules.",
    "noMasteryEnchant": true,
    "duplicate": "Exclude owned canonical ordinary-mode powers before Gift; no duplicate reward or thematic source package.",
    "slotKey": "One shared [runId,characterId,power-mastery] gate, reused by all later grants."
  },
  "narrationContract": {
    "sequence": [
      "effect-reveal",
      "reaction",
      "child-result-if-required",
      "reaction",
      "pending-effect-summary"
    ],
    "facts": "Only completed result IDs, selected target, registered pending effect and bounded amount.",
    "futureUnknown": true,
    "fixedRevealIsNotSpin": true,
    "memes": "Choose reaction footage later from an approved media library; no new media assets or forecasts here.",
    "finalBonusTiming": "Describe registered +1/+2; do not fabricate a settled total before final phase."
  },
